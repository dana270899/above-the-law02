{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:game",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self)"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/desktop",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/game",
      "permanent": false
    },
    {
      "source": "/ranking-preview",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/win/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!editor(?:/|$)|api/editor(?:[-/]|$)).*)",
      "destination": "/index.html"
    }
  ]
}
