{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:preview",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/mini-game-test/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/mini-game-test/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self)"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/mini-game-test",
      "destination": "/mini-game-test/",
      "permanent": false
    },
    {
      "source": "/desktop",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/game",
      "permanent": false
    },
    {
      "source": "/ranking-preview",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/win/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!editor(?:/|$)|api/editor(?:[-/]|$)).*)",
      "destination": "/index.html"
    }
  ]
}
