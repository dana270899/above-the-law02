{
  "name": "above-the-law",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mini-game-test": "vite --config vite.minigame-test.config.ts",
    "build": "npm run build:preview",
    "build:preview": "npm run build:game && npm run build:mini-game-test",
    "build:game": "tsc -b && vite build --mode game && npm run verify:game-build",
    "build:mini-game-test": "vite build --config vite.minigame-test.config.ts && npm run verify:mini-game-test-build",
    "test": "vitest run",
    "preview": "vite preview",
    "preview:mini-game-test": "vite preview --config vite.minigame-test.config.ts",
    "verify:game-build": "node scripts/verify-game-build.mjs",
    "verify:mini-game-test-build": "node scripts/verify-mini-game-test-build.mjs"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@xyflow/react": "^12.3.6",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "uuid": "^11.0.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
